{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "commonjs",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:mobile": "vite --host --port 5174",
        "build:watch": "vite build --watch",
        "sync:mobile": "npm run build && npm run dev:mobile",
        "dev:all": "concurrently \"npm run dev\" \"npm run dev:mobile\"",
        "build:prod": "vite build --mode production",
        "preview": "vite preview",
        "clean": "rimraf public/build public/hot",
        "build:memory": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
        "dev:memory": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vite",
        "watch:sync": "node scripts/file-watcher.js",
        "dev:sync": "concurrently \"npm run dev\" \"npm run watch:sync\"",
        "build:platform": "node scripts/build-process.js build",
        "validate:build": "node scripts/build-process.js validate",
        "sync:platforms": "node scripts/build-process.js sync",
        "test:sync": "node scripts/sync-validator.js full",
        "test:sync:quick": "node scripts/sync-validator.js quick",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "ai:help": "node scripts/ai-helper.js help",
        "ai:check": "node scripts/ai-helper.js check",
        "ai:component": "node scripts/ai-helper.js component",
        "ai:debug": "node scripts/ai-helper.js debug",
        "ai:validate": "node scripts/ai-helper.js validate",
        "ai:migrate": "node scripts/ai-helper.js migrate",
        "ai:task": "echo 'Enter your task:' && read task && g3 \"$task\"",
        "ai:autonomous": "g3 --autonomous",
        "ai:plan": "g3 --planning --codepath . --workspace ../g3_workspace"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest-axe": "^3.5.9",
        "@vitest/ui": "^4.0.15",
        "axios": "^1.11.0",
        "chokidar": "^4.0.1",
        "concurrently": "^9.0.1",
        "cross-env": "^10.1.0",
        "fast-check": "^4.4.0",
        "jest-axe": "^10.0.0",
        "jsdom": "^27.3.0",
        "laravel-vite-plugin": "^2.0.0",
        "rimraf": "^6.0.1",
        "tailwindcss": "^4.0.0",
        "terser": "^5.44.1",
        "vite": "^7.0.7",
        "vitest": "^4.0.15"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@hookform/resolvers": "^5.2.2",
        "@inertiajs/progress": "^0.2.7",
        "@inertiajs/react": "^2.2.19",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-navigation-menu": "^1.2.14",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@tiptap/extension-image": "^3.13.0",
        "@tiptap/extension-link": "^3.13.0",
        "@tiptap/extension-placeholder": "^3.13.0",
        "@tiptap/extension-text-align": "^3.13.0",
        "@tiptap/extension-underline": "^3.13.0",
        "@tiptap/pm": "^3.13.0",
        "@tiptap/react": "^3.13.0",
        "@tiptap/starter-kit": "^3.13.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "embla-carousel-autoplay": "^8.6.0",
        "embla-carousel-fade": "^8.6.0",
        "embla-carousel-react": "^8.6.0",
        "framer-motion": "^12.23.25",
        "hugeicons-react": "^0.3.0",
        "lucide-react": "^0.556.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "react-hook-form": "^7.68.0",
        "tailwind-merge": "^3.4.0",
        "typescript": "^5.9.3",
        "zod": "^4.1.13"
    }
}
